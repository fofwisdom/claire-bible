# Copy to .env. This file contains application runtime and Compose settings only.

# Compose identity and image. Set CB_IMAGE_TAG to an immutable Git SHA in deployments
# so every service runs the exact same image.
CB_PROJECT_NAME=claire-bible
CB_IMAGE=claire-bible
CB_IMAGE_TAG=local
CB_ENV_FILE=.env

# Host persistence paths mounted at /app/data and /app/vault.
CB_DATA_DIR=./data
CB_VAULT_DIR=./vault

# API host publishing. The container always listens on 0.0.0.0 at CB_API_PORT.
CB_API_BIND=127.0.0.1
CB_API_PORT=8765

# Maximum seconds for lifecycle commands to wait for services to become healthy.
CB_WAIT_TIMEOUT=120

# Background worker cadence and batch sizes.
CB_REFRESH_INTERVAL=3600
CB_REFRESH_BATCH=5
CB_RECOVER_INTERVAL=600
CB_RECOVER_BATCH=5
CB_RECOVER_MAX_ATTEMPTS=5
CB_RECOVER_BASE_DELAY=300
CB_EXPAND_INTERVAL=900
CB_EXPAND_BATCH=3

# Gemini (LLM + embeddings). Without a key the application uses the mock provider.
GEMINI_API_KEY=

# Telegram bot token from @BotFather. Leave empty to keep the bot profile disabled.
TELEGRAM_BOT_TOKEN=

# Optional comma-separated Telegram user IDs allowed to use the bot (empty = all).
CLAIRE_ALLOWED_USERS=

# Optional ops-alert chat ID. Empty/0 falls back to CLAIRE_ALLOWED_USERS.
CLAIRE_OWNER_CHAT_ID=0

# Provider and model selection.
CLAIRE_PROVIDER=mock
CLAIRE_GEMINI_MODEL=gemini-3.1-flash-lite
CLAIRE_GEMINI_EMBED_MODEL=gemini-embedding-001
CLAIRE_GEMINI_MIN_INTERVAL=4
CLAIRE_GEMINI_MAX_RETRIES=5

# Paths inside the container. Host paths are configured separately with CB_*_DIR.
CLAIRE_DB_PATH=data/claire.db
CLAIRE_VAULT_PATH=vault

# Vector backend: auto (sqlite-vec then brute fallback), brute, or vec.
CLAIRE_VECTOR_BACKEND=auto

# One-hop expansion and watched-document refresh policy.
CLAIRE_EXPAND_MAX=5
CLAIRE_AUTO_EXPAND=1
CLAIRE_WATCH_INTERVAL_DAYS=1

# API authentication and link generation.
CLAIRE_READONLY_TOKEN=
CLAIRE_INJECT_TOKEN=
CLAIRE_PUBLIC_URL=
