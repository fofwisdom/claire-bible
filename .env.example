# Copy to .env and fill in. .env is gitignored.

# Remote Docker deployment (read by deploy.sh; ignored by the application).
# Leave DEPLOY_REMOTE/PATH blank for local-only use.
# DEPLOY_REMOTE accepts user@host or an SSH config alias.
DEPLOY_REMOTE=
DEPLOY_PORT=22
DEPLOY_PATH=
# if-missing: upload on first deploy, then preserve remote (safe default).
# always: local .env is canonical / never: manage remotely.
DEPLOY_ENV_SYNC=if-missing

# Gemini (LLM + embeddings). Until provided, the app runs with the MOCK provider.
GEMINI_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot. Empty = deny all.
CLAIRE_ALLOWED_USERS=
# Development-only opt-in for a deliberately public bot.
CLAIRE_ALLOW_ALL_USERS=false

# Optional: chat ID to receive ops alerts (e.g. recovery permanent-failure).
# Empty (0) → falls back to CLAIRE_ALLOWED_USERS (personal DM: chat_id == user_id).
CLAIRE_OWNER_CHAT_ID=

# Provider selection: "mock" (default until key arrives) or "gemini".
CLAIRE_PROVIDER=mock

# Outbound web fetches allow public IPs only. Add only intentional private CIDRs, comma-separated.
CLAIRE_FETCH_ALLOWED_CIDRS=

# Models (used when provider=gemini).
CLAIRE_GEMINI_MODEL=gemini-3.1-flash-lite
CLAIRE_GEMINI_EMBED_MODEL=gemini-embedding-001

# Storage paths (relative to project root).
CLAIRE_DB_PATH=data/claire.db
CLAIRE_VAULT_PATH=vault

# Vector backend: "auto" (try sqlite-vec, fall back to brute-force), "brute", or "vec".
CLAIRE_VECTOR_BACKEND=auto

# 1-hop auto-expansion: max external candidates fetched per ingested document.
CLAIRE_EXPAND_MAX=5

# Refresh loop (복원: 빈약/구버전 문서 재스크랩) — claire_refresh 컨테이너가 사용.
CLAIRE_REFRESH_INTERVAL=3600
CLAIRE_REFRESH_BATCH=5

# Owner bearer token for the local inject API. Empty disables bearer authentication;
# Telegram-issued owner sessions continue to work, but programmatic API calls are denied.
CLAIRE_INJECT_TOKEN=

# Read-only public token — separate from CLAIRE_INJECT_TOKEN(owner bearer). Grants GET-only
# access (search/graph/node/documents) for your own agent/tooling; ingest/dedup-merge/share
# are never reachable with this token. Empty = feature off.
CLAIRE_READONLY_TOKEN=
