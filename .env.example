# Copy to .env. This file documents production runtime and Compose settings.
# Codex CLI settings are included for native-host use and are rejected by Compose preflight.

# Required runtime selector. Development uses .env plus the .env.dev overlay.
CLAIRE_ENVIRONMENT=production

# Container timezone (e.g. Asia/Seoul, UTC). If omitted or blank, cb-manuscript
# automatically detects the host's timedatectl / system timezone.
TZ=

# Compose identity and image. Set CB_IMAGE_TAG to an immutable Git SHA in deployments
# so every service runs the exact same image.
CB_PROJECT_NAME=claire-bible
CB_IMAGE=claire-bible
CB_IMAGE_TAG=local
CB_ENV_FILE=.env

# Host persistence paths mounted at /app/data and /app/vault.
CB_DATA_DIR=./data
CB_VAULT_DIR=./vault

# API host publishing. The container listens on 0.0.0.0, while Docker publishes
# only this exact host IPv4. Loopback is a safe initial value; for a reverse proxy
# on another LAN host, replace it with this host's fixed LAN IPv4.
CB_API_BIND=127.0.0.1
CB_API_PORT=8765

# Maximum seconds for lifecycle commands to wait for services to become healthy.
CB_WAIT_TIMEOUT=120

# Background worker cadence and batch sizes.
CB_REFRESH_INTERVAL=3600
CB_REFRESH_BATCH=5
CB_RECOVER_INTERVAL=600
CB_RECOVER_BATCH=5
CB_RECOVER_MAX_ATTEMPTS=5
CB_RECOVER_BASE_DELAY=300
CB_EXPAND_INTERVAL=900
CB_EXPAND_BATCH=3

# Gemini (LLM + embeddings). Without a key, Gemini selection uses the mock
# provider; Codex selection skips new embeddings and uses FTS-only retrieval.
GEMINI_API_KEY=

# Telegram bot token from @BotFather. Leave empty to keep the bot profile disabled.
TELEGRAM_BOT_TOKEN=

# Optional comma-separated Telegram user IDs allowed to use the bot (empty = all).
TELEGRAM_ALLOWED_USERS=

# Optional ops-alert chat ID. Empty/0 falls back to TELEGRAM_ALLOWED_USERS.
TELEGRAM_OWNER_CHAT_ID=0

# Provider and model selection. (mock, gemini, antigravity, codex, or codex-cli)
CLAIRE_PROVIDER=mock
CLAIRE_GEMINI_MODEL=gemini-3.1-flash-lite
CLAIRE_GEMINI_EFFORT=medium
CLAIRE_GEMINI_EMBED_MODEL=gemini-embedding-001
CLAIRE_GEMINI_MIN_INTERVAL=4
CLAIRE_GEMINI_MAX_RETRIES=5

# Antigravity CLI provider settings (used when CLAIRE_PROVIDER=antigravity)
CLAIRE_AGY_BIN=agy
CLAIRE_AGY_MODEL=gemini-3.7-flash
CLAIRE_AGY_EFFORT=medium
CLAIRE_AGY_TIMEOUT=120
CLAIRE_AGY_MAX_CONCURRENCY=2

# Codex CLI provider settings (native host only; Docker/Compose rejects this
# provider). Leave CLAIRE_CODEX_MODEL empty to use the authenticated account's
# default model. GEMINI_API_KEY enables Gemini embeddings; without it, Codex
# provider searches use FTS only.
CLAIRE_CODEX_BIN=codex
CLAIRE_CODEX_MODEL=
CLAIRE_CODEX_EFFORT=medium
CLAIRE_CODEX_TIMEOUT=300
CLAIRE_CODEX_MAX_CONCURRENCY=1

# TypeSafe AI Jev (System 1 Decision Engine Option)
# Fast non-autoregressive decision matrix classifier for entity resolution.
# If disabled or unconfigured, falls back to standard cosine similarity matrix.
CLAIRE_ENABLE_JEV=0
CLAIRE_JEV_API_KEY=
CLAIRE_JEV_BASE_URL=https://api.typesafe.ai/v1
CLAIRE_JEV_TIMEOUT=15.0

# Video & Audio Transcription (STT) settings.
# When enabled (1), web video pages without native subtitles are processed via ffmpeg/yt-dlp
# and transcribed with timestamps. When disabled (0), only text metadata is fetched.
# Supported providers: gemini (production, requires GEMINI_API_KEY) or mock.
# Note: Antigravity CLI does not support audio STT.
CLAIRE_ENABLE_VIDEO_TRANSCRIPTION=1
CLAIRE_STT_PROVIDER=gemini
CLAIRE_STT_MODEL=
CLAIRE_STT_LANGUAGE=ko
CLAIRE_FFMPEG_BIN=ffmpeg
CLAIRE_YTDLP_EXTRACTOR_ARGS=generic:impersonate
# Maximum original Presentation PDF attachment size downloaded from supported video pages (64 MiB)
CLAIRE_PRESENTATION_PDF_MAX_BYTES=67108864

# Paths inside the container. Host paths are configured separately with CB_*_DIR.
CLAIRE_DB_PATH=data/claire.db
CLAIRE_VAULT_PATH=vault

# Vector backend: auto (sqlite-vec then brute fallback), brute, or vec.
CLAIRE_VECTOR_BACKEND=auto

# Reading render format: md (Markdown) or adoc (AsciiDoc)
CLAIRE_RENDER_FORMAT=adoc

# Data lifecycle policy: purgeable (default) or append-only (lossless).
# In append-only mode, destructive purge commands (claire purge) are blocked by policy.
CLAIRE_DATA_LIFECYCLE=purgeable
CLAIRE_ALLOW_PURGE=1
# Multi-theme (multi-database) mode: 0 (default, single-theme mode with zero overhead) or 1 (enabled).
# When enabled, knowledge managers can define, update, and manage isolated theme databases dynamically.
CLAIRE_MULTI_THEME=0

# One-hop expansion and watched-document refresh policy.
CLAIRE_EXPAND_MAX=5
CLAIRE_AUTO_EXPAND=1
CLAIRE_WATCH_INTERVAL_DAYS=1

# Project-wide preferred languages (comma-separated, e.g. ko, ja).
# English ('en') is always included as standard fallback across features. Default: ko
CLAIRE_PREFERRED_LANGUAGES=ko

# Text slicing and character budgets.
# Raw text ingestion character budget (web, text, xcom, youtube)
CLAIRE_RAW_CHAR_BUDGET=20000
# Maximum text characters extracted from PDF streams (I/O, storage & prompt budget)
CLAIRE_PDF_MAX_EXTRACT_CHARS=50000
# Minimum text length (chars) required to trigger high reasoning effort for academic papers
CLAIRE_PDF_PAPER_THRESHOLD_CHARS=15000
# Policy to exclude appendix sections from academic paper PDFs during ingestion (1/true/0/false)
CLAIRE_PDF_EXCLUDE_APPENDIX=true
# Policy to exclude references/bibliography sections from academic paper PDFs during ingestion (1/true/0/false)
CLAIRE_PDF_EXCLUDE_REFERENCES=true
# PDF parser engine: default (fast Chromium PDFium) or docling (advanced layout & OCR)
CLAIRE_PDF_PARSER=default
# Detect encoding flaws (CID font missing, PUA characters, replacement chars) in PDF
CLAIRE_PDF_DETECT_ENCODING_FLAWS=true
# Escalate to Docling for OCR/layout recovery when PDF encoding flaws are detected
CLAIRE_PDF_FLAW_ESCALATE_DOCLING=true
# Reasoning effort for academic paper PDFs with characters >= CLAIRE_PDF_PAPER_THRESHOLD_CHARS (high, medium, low)
CLAIRE_PDF_PAPER_EFFORT=high
# Default reasoning effort for non-paper PDFs or short PDFs (empty falls back to provider default env)
CLAIRE_PDF_DEFAULT_EFFORT=
# Reasoning effort used for 1st-stage academic paper classification (lowest effort provider selected)
CLAIRE_PDF_CLASSIFIER_EFFORT=low
# Knowledge-graph extraction prompt single document budget
CLAIRE_EXTRACT_CHAR_BUDGET=20000
# Merged document budget (0 auto-calculates to CLAIRE_EXTRACT_CHAR_BUDGET * 2)
CLAIRE_MERGED_EXTRACT_CHAR_BUDGET=0
# Slicing strategy: table-exemption (preserves tables) or strict (hard truncate)
CLAIRE_SLICING_STRATEGY=table-exemption
# Embedding vector text input character limit
CLAIRE_EMBED_CHAR_BUDGET=8000
# One-hop expansion and candidate selection context limit
CLAIRE_EXPAND_CHAR_BUDGET=2000
# Research context window limit
CLAIRE_RESEARCH_CONTEXT_BUDGET=8000

# API authentication, canonical public domain (FQDN), and exact cross-origin allowlist.
# Tokens use 32-128 URL-safe characters. `./cb-manuscript init` generates the
# owner token when this value is blank; readonly may remain blank.
CLAIRE_READONLY_TOKEN=
CLAIRE_COLLABORATOR_TOKEN=
CLAIRE_INJECT_TOKEN=
# Exact 0 or 1. 1 exposes read routes without credentials on the canonical
# same-origin site (hidden documents are excluded); owner credentials and
# write routes remain enabled.
CLAIRE_ANONYMOUS_READONLY=1
# Canonical public domain hostname (FQDN, e.g. claire.example.com).
# In production, Claire Bible operates as an HTTPS service behind an upstream protective reverse proxy (e.g. Sophos Firewall WSP, Cloudflare).
CLAIRE_FQDN=claire.example.com
# Optional Cloudflare IP protection: Set to 1 to restrict incoming requests on public IP ranges
# strictly to Cloudflare's published IP ranges (https://www.cloudflare.com/ko-kr/ips/).
# Private IP traffic (LAN, local reverse proxies, Docker bridge) is always permitted. Default: 0
CLAIRE_CLOUDFLARE_IPS_ONLY=0
# Comma-separated origins without paths or wildcards. Empty = same-origin only.
CLAIRE_CORS_ALLOWED_ORIGINS=

# Optional Google Analytics 4 (GA4) measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics and preserve strict CSP without external requests.
CLAIRE_GA_MEASUREMENT_ID=

# Source repository containing the application code and base URL.
GITHUB_REPOSITORY=fofwisdom/claire-bible
SOURCE_BASE_URL=https://github.com/$GITHUB_REPOSITORY

# Knowledge manager identifier displayed in drawer footer ('지식 관리자: <환경변수>', defaults to owner).
CLAIRE_SORCERER=owner

# On-Premises & Private Network Scraping (SSRF policy)
# Set to 1/true to allow collectors to scrape private intranet IPs (10.x, 172.16-31.x, 192.168.x, 127.x).
# Cloud metadata (169.254.169.254) remains strictly prohibited in all environments.
CLAIRE_ALLOW_PRIVATE_NETWORKS=0
# Optional comma-separated CIDR or domain allowlist (e.g. 10.0.0.0/8,192.168.1.0/24,wiki.corp.internal)
CLAIRE_PRIVATE_NETWORK_ALLOWLIST=
