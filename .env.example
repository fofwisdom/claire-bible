# Copy to .env and fill in. .env is gitignored.

# Gemini (LLM + embeddings). Until provided, the app runs with the MOCK provider.
GEMINI_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = allow all).
CLAIRE_ALLOWED_USERS=

# Optional: chat ID to receive ops alerts (e.g. recovery permanent-failure).
# Empty (0) → falls back to CLAIRE_ALLOWED_USERS (personal DM: chat_id == user_id).
CLAIRE_OWNER_CHAT_ID=

# Provider selection: "mock" (default until key arrives) or "gemini".
CLAIRE_PROVIDER=mock

# Models (used when provider=gemini).
CLAIRE_GEMINI_MODEL=gemini-3.1-flash-lite
CLAIRE_GEMINI_EMBED_MODEL=gemini-embedding-001

# Storage paths (relative to project root).
CLAIRE_DB_PATH=data/claire.db
CLAIRE_VAULT_PATH=vault

# Vector backend: "auto" (try sqlite-vec, fall back to brute-force), "brute", or "vec".
CLAIRE_VECTOR_BACKEND=auto

# 1-hop auto-expansion: max external candidates fetched per ingested document.
CLAIRE_EXPAND_MAX=5

# Refresh loop (복원: 빈약/구버전 문서 재스크랩) — claire_refresh 컨테이너가 사용.
CLAIRE_REFRESH_INTERVAL=3600
CLAIRE_REFRESH_BATCH=5
