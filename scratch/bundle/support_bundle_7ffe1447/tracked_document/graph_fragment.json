      "type": "Person",
      "name": "Richard Rogers",
      "aliases": [
        "리처드 로저스"
      ],
      "props": {},
      "observations": [
        "퐁피두 센터와 로이드 빌딩을 설계한 영국의 대표적인 하이테크 건축가이다."
      ],
      "sources": [
