      "name": "Renzo Piano",
      "aliases": [
        "렌조 피아노"
      ],
      "props": {},
      "observations": [
        "리처드 로저스와 함께 프랑스 파리의 퐁피두 센터를 공동 건축한 이탈리아 건축가이다."
      ],
