      "props": {},
      "observations": [
        "대화 예산 T턴 이내에 대상 모델이 최소 한 번 이상 완전히 입장을 포기하고 붕괴(s=0)한 항목의 비율을 측정하는 지표이다."
      ],
      "sources": [
        "doc_28418a825761"
      ],
      "provisional": false,
