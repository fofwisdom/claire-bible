# Copy to .env.dev. cb-manuscript passes this after .env so these values win.
#
# Everyday development runs the checkout with uv; the docker dev stack is for
# checking production-like conditions. The app itself reads only .env, so load this
# file with `uv run --env-file .env.dev` and pass what compose would inject:
#   CLAIRE_INJECT_HOST=127.0.0.1 CLAIRE_INJECT_PORT=8766 CLAIRE_DB_PATH=.dev/data/claire.db \
#     uv run --env-file .env.dev claire serve-api
# (CLAIRE_INJECT_HOST = CB_API_BIND, CLAIRE_INJECT_PORT = CB_API_PORT, DB under CB_DATA_DIR.)
# The uv process also listens on the role host ports below when their IPv4 equals
# CLAIRE_INJECT_HOST. Do not run it while the docker dev stack is up (same port and data).
# See docs/implementation/COMMANDS.md §1.1.

CLAIRE_ENVIRONMENT=development
TZ=
CB_PROJECT_NAME=claire-bible-dev
CB_IMAGE=claire-bible
CB_IMAGE_TAG=dev
CB_ENV_FILE=.env
CB_DEV_ENV_FILE=.env.dev
CB_DATA_DIR=./.dev/data
CB_VAULT_DIR=./.dev/vault
# Safe local default. Replace both this and CLAIRE_FQDN with the host's
# fixed LAN IPv4 when another development device must connect directly.
CB_API_BIND=127.0.0.1
CB_API_PORT=8766
# Fedify sidecar. Exact 0 or 1. 1 adds the Compose profile `federation` (service `fedify`).
CB_FEDERATION=0
# Host port of the development sidecar on CB_API_BIND. It must be different from CB_API_PORT
# and the role host ports. 8791 does not collide with the production default 8790.
CB_FEDIFY_PORT=8791

TELEGRAM_BOT_TOKEN=
# `./cb-manuscript init` generates the 32+ character owner token; readonly may remain blank.
CLAIRE_INJECT_TOKEN=
CLAIRE_COLLABORATOR_TOKEN=
CLAIRE_READONLY_TOKEN=
# Exact 0 or 1. 1 exposes read routes without credentials (hidden documents excluded).
CLAIRE_ANONYMOUS_READONLY=1
CLAIRE_FQDN=127.0.0.1:8766
# Development role hosts split origins by port on the same IPv4. docker-compose.dev.yml
# publishes CB_USERCONTENT_PORT / CB_MEDIA_PORT on CB_API_BIND and wires them to the same
# container port as CB_API_PORT; an empty port adds no mapping. A role host must be
# CB_API_BIND:<its port>, and every port must differ. Example:
#   CB_USERCONTENT_PORT=8767 with CLAIRE_USERCONTENT_FQDN=127.0.0.1:8767
#   CB_MEDIA_PORT=8768 with CLAIRE_MEDIA_FQDN=127.0.0.1:8768 (optional)
# CLAIRE_SITE_DOMAIN is not needed for IPv4 development hosts.
CB_USERCONTENT_PORT=
CLAIRE_USERCONTENT_FQDN=
CB_MEDIA_PORT=
CLAIRE_MEDIA_FQDN=
CLAIRE_SITE_DOMAIN=
CLAIRE_CORS_ALLOWED_ORIGINS=
# Comma-separated CIDRs of trusted reverse proxies for login-throttle client IPs. Empty = use the peer address.
CLAIRE_TRUSTED_PROXIES=
CLAIRE_GA_MEASUREMENT_ID=
GITHUB_REPOSITORY=fofwisdom/claire-bible
SOURCE_BASE_URL=https://github.com/$GITHUB_REPOSITORY
CLAIRE_SORCERER=owner

# Optional development overrides (defaults inherit from .env).
# CLAIRE_PREFERRED_LANGUAGES=ko
# CLAIRE_LANG=ko
# Note: Load restriction and text slicing settings (raw_char_budget, pdf_*, extract_*, etc.)
# are managed via WebUI (Drawer > 상세 메뉴 > 적재 제한) and stored in data/ingest_limits.json.
# CLAIRE_YTDLP_EXTRACTOR_ARGS=generic:impersonate
# CLAIRE_ALLOW_PRIVATE_NETWORKS=0
# CLAIRE_PRIVATE_NETWORK_ALLOWLIST=

